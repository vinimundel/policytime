POLICYTIME_MODE=demo
POLICYTIME_CORPUS_DIR=corpus
# Live mode requires PostgreSQL, downloaded models, and a Mistral API key.
POLICYTIME_DATABASE_URL=postgresql+psycopg://policytime:local-development-only@localhost:5432/policytime
MISTRAL_API_KEY=
POLICYTIME_MONTHLY_BUDGET_USD=10
POLICYTIME_MODEL_CACHE=.cache/models
POLICYTIME_METRICS_TOKEN=
POLICYTIME_ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
